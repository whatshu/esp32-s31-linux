# ESP-Mosaico CoreBoard V1.2: flash root, CO5300 display and CST9220 touch.
# Merged into linux.config for esp-mosaico_defconfig.
CONFIG_BUILTIN_DTB_NAME="espressif/esp32s31_esp_mosaico"
# The UART is the only console.  The root is the squashfs partition of the
# flash window. All writable files are in the NAND UBIFS overlay.
CONFIG_CMDLINE="earlycon=sbi console=tty0 console=ttyS0,115200 esp32_shm.radio_service=bt root=/dev/mtdblock0 rootfstype=squashfs ro rootwait init=/sbin/nand-overlay-init"

# The CO5300 is refreshed over QSPI from a software framebuffer.
CONFIG_SPI=y
CONFIG_SPI_ESP32S31=y
CONFIG_FB=y
CONFIG_FB_CO5300=y
# CONFIG_FB_SIMPLE is not set
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_HYNITRON_CST9220=y
# CONFIG_TOUCHSCREEN_GOODIX is not set
# CONFIG_HID is not set

# No card, USB host or LED. The shared I2C bus carries the touch controller.
# CONFIG_MMC is not set
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
# CONFIG_USB_SUPPORT is not set
# CONFIG_PHY_ESP32S31_USB is not set
# CONFIG_SCSI is not set
# CONFIG_NEW_LEDS is not set
# CONFIG_EXT4_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_UEVENT_HELPER is not set

# The NOR window is a read-only squashfs root; NAND UBIFS is its writable
# overlay. jffs2 cannot be the upper layer: it has no RENAME_WHITEOUT,
# so overlayfs cannot make a directory where a lower one was deleted.
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_SPI_NAND=y

# Load mtdswap only after resolving the NAND partition by name. Its module
# parameter takes an MTD index, which is not a stable board identifier.
CONFIG_MODULES=y
CONFIG_MTD_SWAP=m
CONFIG_MTD_UBI=y
# squashfs and UBIFS are in this menu, which linux.config turns off.
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
# The root is squashfs with zstd.
CONFIG_SQUASHFS_ZSTD=y
# CONFIG_SQUASHFS_ZLIB is not set
CONFIG_UBIFS_FS=y
# Each compressor keeps a workspace for all time.  LZO is the default.
CONFIG_UBIFS_FS_ADVANCED_COMPR=y
# CONFIG_UBIFS_FS_ZLIB is not set
# CONFIG_UBIFS_FS_ZSTD is not set
CONFIG_OVERLAY_FS=y

# Orderly reboot into the ROM UART/USB downloader.
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_ESP32S31_MODE=y
