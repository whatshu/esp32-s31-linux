From: whatshu <shussm@qq.com>
Subject: [PATCH] usb: dwc2: update the generic PHY on role changes

The ESP32-S31 UTMI PHY requires software-controlled host pull-downs.
Select the PHY mode before forcing the controller role, including the
initial role-switch default. Do this outside the spinlock because the
generic PHY API can sleep, and unwind a temporary clock enable on error.

Fixed-role controllers continue to set their PHY mode in platform.c.

Signed-off-by: whatshu <shussm@qq.com>
---
diff --git a/drivers/usb/dwc2/drd.c b/drivers/usb/dwc2/drd.c
--- a/drivers/usb/dwc2/drd.c
+++ b/drivers/usb/dwc2/drd.c
@@ -9,6 +9,7 @@
 
 #include <linux/clk.h>
 #include <linux/iopoll.h>
+#include <linux/phy/phy.h>
 #include <linux/platform_device.h>
 #include <linux/usb/role.h>
 #include "core.h"
@@ -88,6 +89,7 @@
 	struct dwc2_hsotg *hsotg = usb_role_switch_get_drvdata(sw);
 	unsigned long flags;
 	int already = 0;
+	int ret;
 
 	/* Skip session not in line with dr_mode */
 	if ((role == USB_ROLE_DEVICE && hsotg->dr_mode == USB_DR_MODE_HOST) ||
@@ -111,13 +113,11 @@
 	 * mode and sessions. It is the case if cable is plugged at boot.
 	 */
 	if (!hsotg->ll_hw_enabled && hsotg->clk) {
-		int ret = clk_prepare_enable(hsotg->clk);
+		ret = clk_prepare_enable(hsotg->clk);
 
 		if (ret)
 			return ret;
 	}
-
-	spin_lock_irqsave(&hsotg->lock, flags);
 
 	if (role == USB_ROLE_NONE) {
 		/* default operation mode when usb role is USB_ROLE_NONE */
@@ -126,6 +126,14 @@
 		else if (hsotg->role_sw_default_mode == USB_DR_MODE_PERIPHERAL)
 			role = USB_ROLE_DEVICE;
 	}
+
+	/* PHY mode changes may sleep; keep them outside the controller lock. */
+	ret = phy_set_mode(hsotg->phy, role == USB_ROLE_HOST ?
+			   PHY_MODE_USB_HOST : PHY_MODE_USB_DEVICE);
+	if (ret)
+		goto out_disable_clk;
+
+	spin_lock_irqsave(&hsotg->lock, flags);
 
 	if ((IS_ENABLED(CONFIG_USB_DWC2_PERIPHERAL) ||
 	     IS_ENABLED(CONFIG_USB_DWC2_DUAL_ROLE)) &&
@@ -160,14 +168,15 @@
 		/* This will raise a Connector ID Status Change Interrupt */
 		dwc2_force_mode(hsotg, role == USB_ROLE_HOST);
 
-	if (!hsotg->ll_hw_enabled && hsotg->clk)
-		clk_disable_unprepare(hsotg->clk);
-
 	dev_dbg(hsotg->dev, "%s-session valid\n",
 		role == USB_ROLE_NONE ? "No" :
 		role == USB_ROLE_HOST ? "A" : "B");
 
-	return 0;
+out_disable_clk:
+	if (!hsotg->ll_hw_enabled && hsotg->clk)
+		clk_disable_unprepare(hsotg->clk);
+
+	return ret;
 }
 
 int dwc2_drd_init(struct dwc2_hsotg *hsotg)
@@ -180,6 +189,12 @@
 		return 0;
 
 	hsotg->role_sw_default_mode = usb_get_role_switch_default_mode(hsotg->dev);
+	ret = phy_set_mode(hsotg->phy,
+			   hsotg->role_sw_default_mode == USB_DR_MODE_HOST ?
+			   PHY_MODE_USB_HOST : PHY_MODE_USB_DEVICE);
+	if (ret)
+		return ret;
+
 	role_sw_desc.driver_data = hsotg;
 	role_sw_desc.fwnode = dev_fwnode(hsotg->dev);
 	role_sw_desc.set = dwc2_drd_role_sw_set;
